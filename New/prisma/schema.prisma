datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BudgetStatus {
  ON_TRACK      @map("On Track")
  UNDERUTILIZED @map("Underutilized")
  OVERBUDGET    @map("Overbudget")
  AUDITED_FLAG  @map("Audited Flag")
}

enum PromiseStatus {
  IN_PROGRESS @map("In Progress")
  COMPLETED   @map("Completed")
  STALLED     @map("Stalled")
  NOT_STARTED @map("Not Started")
}

enum KYCStatus {
  VERIFIED @map("Verified")
  PENDING  @map("Pending")
  FLAGGED  @map("Flagged")
}

enum ComplaintStatus {
  OPEN                @map("Open")
  UNDER_INVESTIGATION @map("Under Investigation")
  RESOLVED            @map("Resolved")
  ESCALATED           @map("Escalated")
}

model BudgetCategory {
  id         String   @id @default(cuid())
  department String   @unique
  allocated  Float    // in millions
  spent      Float    // in millions
  status     String   // 'On Track' | 'Underutilized' | 'Overbudget' | 'Audited Flag'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PoliticianAsset {
  id               String     @id @default(cuid())
  name             String
  role             String
  declaredAssets   Float      // in millions
  year2022Assets   Float      // in millions
  year2026Assets   Float      // in millions
  flaggedAnomalies Boolean    @default(false)
  keyAssets        KeyAsset[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model KeyAsset {
  id           String          @id @default(cuid())
  description  String
  politicianId String
  politician   PoliticianAsset @relation(fields: [politicianId], references: [id], onDelete: Cascade)
}

model PromiseItem {
  id              String   @id @default(cuid())
  title           String
  category        String
  progress        Int      @default(0) // 0-100 percentage
  status          String   // 'In Progress' | 'Completed' | 'Stalled' | 'Not Started'
  targetYear      Int
  budgetAllocated String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KYCRecord {
  id               String   @id @default(cuid())
  name             String
  designation      String
  nidNumber        String   @unique
  taxClearanceYear Int
  conflictDeclared Boolean  @default(false)
  kycStatus        String   // 'Verified' | 'Pending' | 'Flagged'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ComplaintItem {
  id         String   @id @default(cuid())
  ticketId   String   @unique
  subject    String
  department String
  status     String   @default("Open") // 'Open' | 'Under Investigation' | 'Resolved' | 'Escalated'
  upvotes    Int      @default(1)
  date       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
